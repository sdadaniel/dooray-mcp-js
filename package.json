{
  "name": "dooray-mcp-js",
  "version": "0.2.1",
  "description": "Dooray MCP server implemented in Node.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdadaniel/dooray-mcp.git"
  },
  "files": [
